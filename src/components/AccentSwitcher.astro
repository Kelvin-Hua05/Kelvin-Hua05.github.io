---
import { useT } from '../i18n/translations';
import type { Locale } from '../i18n/locales';
interface Props { locale: Locale; labels?: boolean; class?: string }
const { locale, labels = false, class: cls } = Astro.props;
const t = useT(locale);
const opts = [
  { id: 'dual', name: t.accent.dual },
  { id: 'violet', name: t.accent.violet },
  { id: 'cyan', name: t.accent.cyan },
];
---
<div class:list={['accent-switch', labels && 'with-labels', cls]} role="group" aria-label={t.accent.label}>
  {opts.map((o) => (
    <button type="button" data-accent={o.id} data-announce={`${t.accent.label}: ${o.name}`} aria-pressed={o.id === 'dual' ? 'true' : 'false'} aria-label={o.name} title={o.name}>
      <span class={`swatch swatch-${o.id}`} aria-hidden="true"></span>
      {labels && <span>{o.name}</span>}
    </button>
  ))}
</div>
