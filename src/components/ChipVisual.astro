---
import { useT } from '../i18n/translations';
import type { Locale } from '../i18n/locales';
const { locale } = Astro.props as { locale: Locale };
const t = useT(locale);
const pinsTop = [96, 120, 144, 168], pinsSide = [96, 120, 144, 168];
---
<div class="chip-visual" data-chip>
  <svg viewBox="0 0 264 264" fill="none" role="img" aria-label={t.hero.chipAlt}>
    <defs>
      <linearGradient id="dc-grad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color: var(--accent)" />
        <stop offset="1" style="stop-color: var(--accent-2)" />
      </linearGradient>
      <clipPath id="dc-clip"><rect x="72" y="72" width="120" height="120" rx="4" /></clipPath>
    </defs>
    <!-- trace routes -->
    <g class="traces" stroke-width="1.4" stroke-linecap="round">
      {pinsTop.map((x, i) => <path d={`M${x} 72V${i % 2 ? 36 : 22}H${i % 2 ? x - 40 : x + 30}`} stroke={i < 2 ? 'var(--accent)' : 'var(--accent-2)'} />)}
      {pinsTop.map((x, i) => <path d={`M${x} 192V${i % 2 ? 228 : 242}H${i % 2 ? x + 40 : x - 30}`} stroke={i < 2 ? 'var(--accent)' : 'var(--accent-2)'} />)}
      {pinsSide.map((y, i) => <path d={`M72 ${y}H${i % 2 ? 36 : 22}V${i % 2 ? y - 40 : y + 30}`} stroke="var(--accent)" />)}
      {pinsSide.map((y, i) => <path d={`M192 ${y}H${i % 2 ? 228 : 242}V${i % 2 ? y + 40 : y - 30}`} stroke="var(--accent-2)" />)}
    </g>
    <g class="nodes" stroke-width="1.4">
      <circle cx="22" cy="22" r="0" /><circle cx="96" cy="22" r="3.5" stroke="var(--accent)" /><circle cx="174" cy="22" r="0" />
      <circle cx="242" cy="150" r="3.5" stroke="var(--accent-2)" /><circle cx="150" cy="242" r="3.5" stroke="var(--accent-2)" /><circle cx="22" cy="150" r="3.5" stroke="var(--accent)" />
    </g>
    <!-- die -->
    <rect x="72" y="72" width="120" height="120" rx="4" stroke="url(#dc-grad)" stroke-width="2" fill="var(--bg-2)" />
    <g clip-path="url(#dc-clip)">
      <rect class="scan" x="72" y="72" width="120" height="14" fill="url(#dc-grad)" opacity="0.28" />
    </g>
    <!-- two cores -->
    <rect x="86" y="86" width="44" height="92" rx="2" stroke="var(--accent)" stroke-width="1.6" />
    <rect x="134" y="86" width="44" height="92" rx="2" stroke="var(--accent-2)" stroke-width="1.6" />
    <path d="M96 104h24M96 120h24M96 136h14M144 104h24M144 120h14M144 136h24" stroke="var(--accent)" stroke-width="1.2" opacity=".55" />
    <path d="M130 132h4" stroke="url(#dc-grad)" stroke-width="2" />
    <text x="108" y="164" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--accent)">A</text>
    <text x="156" y="164" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--accent-2)">B</text>
  </svg>
  <ul class="chip-labels" aria-label={t.hero.decorative}>
    <li><span class="dot" aria-hidden="true"></span>{t.hero.status1}</li>
    <li>{t.hero.status2}</li>
  </ul>
</div>
