---
import CircuitArt from './CircuitArt.astro';
import { withBase } from '../lib/url';
import { slugOf, type Project } from '../lib/content';
import { useT } from '../i18n/translations';
import type { Locale } from '../i18n/locales';
interface Props { project: Project; locale: Locale }
const { project, locale } = Astro.props;
const { data } = project;
const t = useT(locale);
const href = withBase(`/${locale}/projects/${slugOf(project)}/`);
---
<article class="card" data-category={data.category}>
  <div class="card-thumb">
    {data.thumbnail
      ? <img src={withBase(data.thumbnail)} alt={data.thumbnailAlt ?? ''} loading="lazy" width="640" height="360" />
      : <CircuitArt seed={data.translationKey} />}
  </div>
  <div class="card-body">
    <div class="chips">
      <span class="chip">{data.category}</span>
      {data.sample && <span class="chip chip-sample">{t.common.sample}</span>}
    </div>
    <h3><a href={href}>{data.title}</a></h3>
    <p>{data.description}</p>
    {data.tags.length > 0 && <ul class="chips" aria-label={t.projects.tags}>{data.tags.map((tag) => <li class="chip">{tag}</li>)}</ul>}
    {(data.githubUrl || data.demoUrl) && (
      <div class="card-links">
        {data.githubUrl && <a href={data.githubUrl} target="_blank" rel="noopener noreferrer">{t.common.github}<span class="sr-only"> {t.common.externalNewTab}</span></a>}
        {data.demoUrl && <a href={data.demoUrl} target="_blank" rel="noopener noreferrer">{t.common.demo}<span class="sr-only"> {t.common.externalNewTab}</span></a>}
      </div>
    )}
  </div>
</article>
