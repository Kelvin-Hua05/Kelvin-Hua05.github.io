---
import { absoluteUrl, withBase } from '../lib/url';
import { localeMeta, type Locale } from '../i18n/locales';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Route path without base, e.g. "/en/about/". */
  path: string;
  /** Only genuine translations. */
  alternates?: Partial<Record<Locale, string>>;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description, locale, path, alternates = {}, ogType = 'website', noindex = false } = Astro.props;
const canonical = absoluteUrl(path, Astro.site);
const ogImage = absoluteUrl(site.ogImage, Astro.site);
const altEntries = Object.entries(alternates).filter(([, p]) => !!p) as [Locale, string][];
const hasBoth = altEntries.length > 1;
const otherOg = altEntries.filter(([l]) => l !== locale).map(([l]) => localeMeta[l].ogLocale);
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
{hasBoth && altEntries.map(([l, p]) => <link rel="alternate" hreflang={localeMeta[l].hreflang} href={absoluteUrl(p, Astro.site)} />)}
<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
<link rel="sitemap" href={withBase('sitemap-index.xml')} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={localeMeta[locale].ogLocale} />
{hasBoth && otherOg.map((o) => <meta property="og:locale:alternate" content={o} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
