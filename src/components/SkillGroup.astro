---
import { pick, type Locale } from '../i18n/locales';
import type { SkillGroupData } from '../data/skills';
interface Props { group: SkillGroupData; locale: Locale }
const { group, locale } = Astro.props;
const title = pick(group.category, locale);
---
{title && group.items.length > 0 && (
  <div>
    <h3>{title}</h3>
    <ul class="chips">
      {group.items.map((i) => <li class="chip" title={pick(i.description, locale) || undefined}>{i.name}</li>)}
    </ul>
  </div>
)}
