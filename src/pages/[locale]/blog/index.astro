---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { staticPaths, altFor } from '../../../lib/pages';
import { isLocale } from '../../../i18n/locales';
import { useT } from '../../../i18n/translations';
import { getPosts } from '../../../lib/content';
export const getStaticPaths = staticPaths;
const locale = Astro.params.locale;
if (!isLocale(locale)) throw new Error('bad locale');
const t = useT(locale);
const posts = await getPosts(locale);
---
<BaseLayout locale={locale} title={t.blog.title} description={t.seo.blog} path={`/${locale}/blog/`} alternates={altFor('blog')}>
  <div class="wrap">
    <header class="page-head"><h1>{t.blog.title}</h1><p class="lead">{t.blog.lead}</p></header>
    <section class="section">
      {posts.length === 0 ? <p class="muted">{t.common.empty}</p> : <div class="grid-cards">{posts.map((p) => <ArticleCard post={p} locale={locale} />)}</div>}
    </section>
  </div>
</BaseLayout>
